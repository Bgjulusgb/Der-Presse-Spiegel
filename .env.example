# Lokales Pressespiegel-Tool - alle Daten bleiben auf diesem Rechner.
# Es werden keine E-Mails versendet, keine Cloud-APIs verwendet.

# Logging-Level: debug | info | warn | error
LOG_LEVEL=info

# Scraping (alle Felder optional, sinnvolle Defaults sind gesetzt)
USER_AGENT=PressespiegelBot/1.1 (+lokale-installation)
REQUEST_TIMEOUT=20000
MAX_CONCURRENT_REQUESTS=4
