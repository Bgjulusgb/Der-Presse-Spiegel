# E-Mail-Konfiguration (fuer Report-Versand und Alerts)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=user@example.com
SMTP_PASS=changeme
SMTP_FROM=pressespiegel@kammerspiele.de

# Empfaenger fuer Berichte (komma-getrennt)
REPORT_RECIPIENTS=intendanz@kammerspiele.de,presse@kammerspiele.de
ALERT_RECIPIENTS=presse@kammerspiele.de

# Optional: Google Custom Search (Backup-Quelle, 100 req/day kostenlos)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# Logging
LOG_LEVEL=info

# Scraping
USER_AGENT=PressespiegelBot/1.0 (+https://www.muenchner-kammerspiele.de)
REQUEST_TIMEOUT=20000
MAX_CONCURRENT_REQUESTS=4
